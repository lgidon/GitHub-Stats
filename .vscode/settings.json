{
    "workbench.editorAssociations": {
        "*.parquet": "duckdb.dataFileViewer",
        "*.csv": "duckdb.dataFileViewer",
        "*.tsv": "duckdb.dataFileViewer",
        "*.xlsx": "duckdb.dataFileViewer"
    },
    "duckdb.databases": [
        {
            "alias": "warehouse",
            "type": "file",
            "path": "/workspaces/GitHub-Stats/data/warehouse.duckdb",
            "readOnly": true,
            "attached": false
        },
        {
            "alias": "dev",
            "type": "file",
            "path": "/workspaces/GitHub-Stats/transform/dev.duckdb",
            "attached": false,
            "readOnly": false
        }
    ],
    "duckdb.defaultDatabase": "dev",
    "files.autoSave": "off",
    "editor.acceptSuggestionOnEnter": true,
    "editor.quickSuggestions": {
        "other": false,
        "comments": false,
        "strings": false
    },
    "editor.quickSuggestionsDelay": 300
}